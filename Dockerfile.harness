FROM node:24-bookworm-slim

ENV NODE_ENV=production \
    DSH_HOME=/data/dsh \
    NOODLE_API_BASE_URL=http://noodle-api:8000 \
    NOODLE_API_PREFIX=/internal/next

WORKDIR /app

COPY package.json package-lock.json LICENSE THIRD_PARTY_NOTICES.md ./
RUN npm ci --include=dev

COPY tsconfig.json cordis.patch.yml ./
COPY src ./src
COPY services/noodle/src/noodle_agent/web/next ./services/noodle/src/noodle_agent/web/next
COPY scripts/build-plugin.mjs scripts/build-graph.mjs scripts/build-agent-client.mjs scripts/start-harness.mjs ./scripts/
COPY config/agent-presets/noodle-knowledge ./config/agent-presets/noodle-knowledge
RUN npm run build

EXPOSE 3080

CMD ["node", "scripts/start-harness.mjs"]
