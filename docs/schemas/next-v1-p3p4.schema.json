          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Request Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "READY",
            "PROFILE_MISMATCH",
            "INDEX_PENDING",
            "NO_EVIDENCE",
            "SCOPE_RESTRICTED",
            "CLARIFICATION_REQUIRED",
            "PROVIDER_ERROR",
            "CONTENT_CHANGED",
            "COVERAGE_GAP"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/Hit"
          },
          "title": "Hits",
          "type": "array"
        },
        "counts": {
          "$ref": "#/$defs/Counts"
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        },
        "timings_ms": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Timings Ms",
          "type": "object"
        },
        "degraded_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Degraded Reason"
        },
        "diagnostics": {
          "anyOf": [
            {
              "$ref": "#/$defs/Diagnostics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "answer_markdown": {
          "title": "Answer Markdown",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "status",
        "message",
        "hits",
        "counts",
        "snapshot",
        "timings_ms",
        "degraded_reason",
        "answer_markdown",
        "citations"
      ],
      "title": "AnswerResponse",
      "type": "object"
    },
