{
  "$defs": {
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "next-v1",
          "default": "next-v1",
          "title": "Contract Version",
          "type": "string"
        },
        "note_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Note Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "entity_hints": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntityHints"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "minItems": 1,
          "title": "Sections",
          "type": "array"
        },
        "origin_source_revisions": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 100,
          "title": "Origin Source Revisions",
          "type": "array"
        },
        "map_entries": {
          "items": {
            "$ref": "#/$defs/MapEntry"
          },
          "title": "Map Entries",
          "type": "array"
        },
        "map_policy": {
          "default": "MANUAL",
          "enum": [
            "MANUAL",
            "AUTO",
            "SOURCE"
          ],
          "title": "Map Policy",
          "type": "string"
        },
        "links": {
          "items": {
            "$ref": "#/$defs/Link"
          },
          "title": "Links",
          "type": "array"
        },
        "policy_version": {
          "default": "writing-next-v1",
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        }
      },
      "required": [
        "note_id",
        "title",
        "scope",
        "sections"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "EntityHints": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "default": "EXPLAIN",
          "enum": [
            "EXPLAIN",
            "COMPARE",
            "OVERVIEW",
            "SUMMARY"
          ],
          "title": "Intent",
          "type": "string"
        },
        "subject": {
          "default": "",
          "title": "Subject",
          "type": "string"
        },
        "subjects": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Subjects",
          "type": "array"
        },
        "context": {
          "default": "",
          "title": "Context",
          "type": "string"
        }
      },
      "title": "EntityHints",
      "type": "object"
    },
    "FragmentRef": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Section Id",
          "type": "string"
        },
        "start_offset": {
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "end_offset": {
          "exclusiveMinimum": 0,
          "title": "End Offset",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "section_id",
        "start_offset",
        "end_offset",
        "sha256"
      ],
      "title": "FragmentRef",
      "type": "object"
    },
    "Input": {
      "additionalProperties": false,
      "properties": {
        "atomic_revision_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Atomic Revision Id",
          "type": "string"
        },
        "fragments": {
          "items": {
            "$ref": "#/$defs/FragmentRef"
          },
          "title": "Fragments",
          "type": "array"
        },
        "section_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Section Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "role": {
          "default": "SUPPORT",
          "enum": [
            "SUPPORT",
            "EXAMPLE",
            "CONTRAST",
            "CONFLICT"
          ],
          "title": "Role",
          "type": "string"
        },
        "action": {
          "enum": [
            "ADD_EVIDENCE",
            "UPDATE_SECTION",
            "CREATE_SECTION",
            "CREATE_CONCEPT"
          ],
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "atomic_revision_id",
        "section_ids",
        "evidence_ids",
        "action"
      ],
      "title": "Input",
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "properties": {
        "from_section_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Section Id"
        },
        "target_note_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Target Note Id",
          "type": "string"
        },
        "target_section_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Section Id"
        },
        "relation": {
          "enum": [
            "LINKS_TO",
            "PREREQUISITE_OF",
            "RELATED_TO",
            "COMPARES_WITH",
            "CONTRADICTS"
          ],
          "title": "Relation",
          "type": "string"
        },
        "status": {
          "enum": [
            "CONFIRMED",
            "SUGGESTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "navigation_role": {
          "anyOf": [
            {
              "enum": [
                "TOPIC_CHILD",
                "TOPIC_PARENT"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Navigation Role"
        },
        "position": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "support_revision_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Support Revision Ids",
          "type": "array"
        }
      },
      "required": [
        "target_note_id",
        "relation",
        "status",
        "basis"
      ],
      "title": "Link",
      "type": "object"
    },
    "MapEntry": {
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Entry Id",
          "type": "string"
        },
        "parent_entry_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Entry Id"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "target_note_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Note Id"
        },
        "target_revision_id": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Revision Id"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "entry_id",
        "title"
      ],
      "title": "MapEntry",
      "type": "object"
    },
    "Review": {
      "additionalProperties": false,
      "properties": {
        "candidate_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "reviewer": {
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "report": {
          "additionalProperties": true,
          "title": "Report",
          "type": "object"
        }
      },
      "required": [
        "candidate_sha256",
        "policy_version",
        "reviewer",
        "passed"
      ],
      "title": "Review",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "includes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Includes",
          "type": "array"
        },
        "excludes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Excludes",
          "type": "array"
        },
        "prerequisites": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Prerequisites",
          "type": "array"
        }
      },
      "required": [
        "includes"
      ],
      "title": "Scope",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "section_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
          "title": "Section Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "markdown": {
          "minLength": 1,
          "title": "Markdown",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/Input"
          },
          "title": "Inputs",
          "type": "array"
        },
        "protected": {
          "default": false,
          "title": "Protected",
          "type": "boolean"
        }
      },
      "required": [
        "section_id",
        "title",
        "question",
        "scope",
        "markdown"
      ],
      "title": "Section",
      "type": "object"
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/Candidate"
    },
    {
      "$ref": "#/$defs/Review"
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noodle:next-v1:publication-contracts",
  "title": "Noodle next-v1 runtime candidate and application review contracts"
}
