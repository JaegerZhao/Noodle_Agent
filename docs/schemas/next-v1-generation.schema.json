{
  "$comment": "Generated from runtime models; oneOf/const retain tagged validation. Real allocation and writing requests additionally require every window/unit property by name.",
  "$defs": {
    "Administrative": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "ADMINISTRATIVE",
          "title": "Mode",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "reason"
      ],
      "title": "Administrative",
      "type": "object"
    },
    "AllocationPlan": {
      "additionalProperties": false,
      "properties": {
        "assignments": {
          "patternProperties": {
            "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Included"
                },
                {
                  "$ref": "#/$defs/Navigation"
                },
                {
                  "$ref": "#/$defs/Administrative"
                },
                {
                  "$ref": "#/$defs/Decorative"
                },
                {
                  "$ref": "#/$defs/Duplicated"
                }
              ]
            }
          },
          "propertyNames": {
            "maxLength": 160,
            "minLength": 1
          },
          "title": "Assignments",
          "type": "object"
        },
        "topics": {
          "items": {
            "$ref": "#/$defs/TopicHeader"
          },
          "title": "Topics",
          "type": "array"
        }
      },
      "required": [
        "topics",
        "assignments"
      ],
      "title": "AllocationPlan",
      "type": "object"
    },
    "Assessment": {
