{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:noodle:design:planned-p3-v1",
  "$comment": "DESIGN ONLY. Not a deployed runtime contract. Semantic and transactional checks are application responsibilities.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "planned-p3-v1"
    },
    "concept_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "base_revision_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "input_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_catalog_generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
    },
    "candidate_search_complete": {
      "type": "boolean"
    },
    "proposed_concept": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "question": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "includes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "excludes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 0
                }
              },
              "required": [
                "includes"
              ]
            },
            "identity_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
            }
          },
          "required": [
            "title",
            "domain",
            "question",
            "scope",
            "identity_key"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "fragments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fragment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
          },
          "atomic_revision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
          },
          "section_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
          },
          "start_offset": {
            "type": "integer",
            "minimum": 0
          },
          "end_offset": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "fragment_id",
          "atomic_revision_id",
          "section_id",
          "start_offset",
          "end_offset",
          "sha256",
          "evidence_ids"
        ]
      },
      "minItems": 0
    },
    "removed_input_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "NO_CHANGE",
              "ADD_EVIDENCE",
              "UPDATE_SECTION",
              "CREATE_SECTION",
              "LINK_ONLY",
              "CREATE_CONCEPT",
              "CONFLICT",
              "INSUFFICIENT"
            ]
          },
          "target_section_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "fragment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "must_preserve": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "link_target_note_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "action",
          "target_section_id",
          "fragment_ids",
          "reason",
          "must_preserve"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "enum": [
                    "ADD_EVIDENCE",
                    "UPDATE_SECTION",
                    "CREATE_SECTION"
                  ]
                }
              },
              "required": [
                "action"
              ],
              "type": "object"
            },
            "then": {
              "properties": {
                "target_section_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                }
              },
              "type": "object"
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "LINK_ONLY"
                }
              },
              "required": [
                "action"
              ],
              "type": "object"
            },
            "then": {
              "required": [
                "link_target_note_id"
              ],
              "properties": {
                "link_target_note_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
                }
              },
              "type": "object"
            }
          }
        ]
      },
      "minItems": 0
    },
    "publication": {
      "enum": [
        "PUBLISH",
        "WITHDRAW"
      ]
    },
    "remove_section_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "contract_version",
    "concept_id",
    "base_revision_id",
    "generation",
    "input_snapshot_sha256",
    "candidate_catalog_generation",
    "candidate_search_complete",
    "proposed_concept",
    "fragments",
    "removed_input_ids",
    "operations",
    "publication",
    "remove_section_ids"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operations": {
            "contains": {
              "properties": {
                "action": {
                  "const": "CREATE_CONCEPT"
                }
              },
              "required": [
                "action"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "operations"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "concept_id": {
            "type": "null"
          },
          "base_revision_id": {
            "type": "null"
          },
          "candidate_search_complete": {
            "const": true
          },
          "proposed_concept": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "includes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "excludes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "includes"
                ]
              },
              "identity_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$"
              }
            },
            "required": [
              "title",
              "domain",
              "question",
              "scope",
              "identity_key"
            ]
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "publication": {
            "const": "WITHDRAW"
          }
        },
        "required": [
          "publication"
        ],
        "type": "object"
      },
      "then": {
        "properties": {
          "concept_id": {
            "type": "string",
            "minLength": 1
          },
          "base_revision_id": {
            "type": "string",
            "minLength": 1
          },
          "operations": {
            "type": "array",
            "maxItems": 0
          },
          "proposed_concept": {
            "type": "null"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "publication": {
            "const": "PUBLISH"
          }
        },
        "required": [
          "publication"
        ],
        "type": "object"
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "operations": {
                "type": "array",
                "minItems": 1
              }
            },
            "type": "object"
          },
          {
            "properties": {
              "remove_section_ids": {
                "type": "array",
                "minItems": 1
              }
            },
            "type": "object"
          }
        ]
      }
    }
  ]
}
