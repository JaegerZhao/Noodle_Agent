NOODLE_DATA_DIR=./.noodle
NOODLE_EXPORT_DIR=./.noodle/exports
NOODLE_PARSER=fixture
NOODLE_LLM=fixture
NOTE_LANGUAGE=zh-CN
NOODLE_SKILLS_DIR=./skills
UPLOAD_MAX_BYTES=104857600
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=180
WORKER_HEARTBEAT_SECONDS=30

# Real MinerU: lightweight (no token, <=10 MB / <=20 pages) or precision.
MINERU_MODE=lightweight
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_POLL_SECONDS=5

# OpenAI-compatible knowledge generation and QA.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_FAST_MODEL=
LLM_PRO_MODEL=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=0
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1024
QA_MIN_RELEVANCE_SCORE=0.22

# Volcengine Ark multimodal vision. DOUBAO_API_KEY is also accepted.
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL=doubao-seed-2-1-turbo-260628
VISION_TIMEOUT_SECONDS=120
VISION_MAX_RETRIES=2
VISION_REASONING_EFFORT=low
VISION_CONCURRENCY=4
VISION_BATCH_SIZE=4
VISION_MAX_OUTPUT_TOKENS=900
KNOWLEDGE_CONCURRENCY=4
PLANNING_SINGLE_CALL_CONCEPT_LIMIT=18
PLANNING_SHARD_SIZE=8
PLANNING_CONCURRENCY=3
DRAFT_CONCURRENCY=4
JUDGE_BATCH_SIZE=4
JUDGE_CONCURRENCY=4
GENERATION_TASK_RETRIES=1

# Alibaba Cloud Model Studio text embeddings. A legacy sk-* key can use the
# public Beijing endpoint below; workspace keys should use their API Host.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# DeepSeek shortcut. Use NOODLE_LLM=deepseek and either these uppercase
# variables or the generic LLM_* variables above.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Event-driven knowledge reconciliation and content-addressed parse cache.
KNOWLEDGE_AUTO_SYNC=true
PARSE_CACHE_ENABLED=true
