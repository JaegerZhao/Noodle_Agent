# DeepSeek Harness -> internal Noodle API.
NOODLE_API_BASE_URL=http://127.0.0.1:8000
NOODLE_API_PREFIX=/internal/next
# Optional local supervisor port; defaults to the port in NOODLE_API_BASE_URL.
# NOODLE_API_PORT=8000
# Change both values together when port 3080 is already occupied by another DSH.
# The launcher exports DSH_WEB_PORT because DSH intentionally forbids it in .env.
NOODLE_DSH_WEB_PORT=3080
NOODLE_HARNESS_WEB_URL=http://127.0.0.1:3080
# Optional; defaults to this repository. Do not copy another machine's path.
# NOODLE_HARNESS_WORKSPACE=/absolute/path/to/Noodle_Agent
NOODLE_API_TIMEOUT_MS=15000

# Harness conversation model. Keep secrets in .env only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-v4-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# Current workbench: npm run dev (dev:next is an alias).
# NOODLE_NEXT_DATA_DIR=./data/knowledge
# NOODLE_NEXT_VISION_CONCURRENCY=2
# Historical stores and frozen runs are retained; no automatic legacy migration.

# Embedded Python knowledge service.
NOODLE_DATA_DIR=./data/knowledge
NOODLE_EXPORT_DIR=./data/knowledge/exports
NOODLE_PARSER=mineru
NOODLE_LLM=deepseek
NOTE_LANGUAGE=zh-CN
UPLOAD_MAX_BYTES=104857600
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=180
WORKER_HEARTBEAT_SECONDS=30

# MinerU.
MINERU_MODE=lightweight
# next-worker / next-run always request precision mode for verifiable PDF page anchors.
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=ch
MINERU_POLL_SECONDS=5

# Noodle knowledge generation. DEEPSEEK_* values above are accepted as aliases.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_FAST_MODEL=
LLM_PRO_MODEL=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=0

# DashScope embeddings.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
QA_MIN_RELEVANCE_SCORE=0.22

# Volcengine Ark multimodal vision.
DOUBAO_API_KEY=
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL=doubao-seed-2-1-turbo-260628
# Cost routing preserves review count and already published checkpoints.
NOODLE_NEXT_COST_POLICY=balanced-cost-v1
VISION_TIMEOUT_SECONDS=120
VISION_MAX_RETRIES=2
VISION_REASONING_EFFORT=low
VISION_CONCURRENCY=4
VISION_BATCH_SIZE=4
VISION_MAX_OUTPUT_TOKENS=900

# Bounded pipeline concurrency.
KNOWLEDGE_CONCURRENCY=4
PLANNING_SINGLE_CALL_CONCEPT_LIMIT=18
PLANNING_SHARD_SIZE=8
PLANNING_CONCURRENCY=3
DRAFT_CONCURRENCY=4
JUDGE_BATCH_SIZE=4
JUDGE_CONCURRENCY=4
GENERATION_TASK_RETRIES=1
# Optional; by default scripts use python from the activated environment.
# NOODLE_PYTHON=C:/path/to/environment/python.exe

# Automatically reconcile published source notes; manual Harness writes still require approval.
KNOWLEDGE_AUTO_SYNC=true

# Reuse exact-content normalized PDF parses; knowledge is regenerated.
PARSE_CACHE_ENABLED=true

# New-system commands only; npm run dev still starts the existing workbench.
NOODLE_NEXT_VECTOR_BACKEND=exact
NOODLE_NEXT_RETRIEVAL_MODE=HYBRID
NOODLE_NEXT_RERANK=off
NOODLE_CHROMA_HOST=127.0.0.1
NOODLE_CHROMA_PORT=8001

# New-system rerank. Set NOODLE_NEXT_RERANK=on and restart the query API.
# llm = compact DeepSeek listwise; dashscope = dedicated native rerank endpoint.
NOODLE_NEXT_RERANK_PROVIDER=dashscope
RERANK_URL=https://YOUR_WORKSPACE.cn-beijing.maas.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-rerank
# Leave empty to reuse DASHSCOPE_API_KEY. Never put keys in client code.
RERANK_API_KEY=
RERANK_TIMEOUT_SECONDS=8
NOODLE_NEXT_RECALL_K=50
NOODLE_NEXT_RERANK_CANDIDATES=10
NOODLE_NEXT_RERANK_TOKENS=8000
NOODLE_NEXT_RERANK_DOCUMENT_TOKENS=3500
NOODLE_NEXT_CONTEXT_TOKENS=4000
NOODLE_NEXT_EXPANSION_TOKENS=800
NOODLE_NEXT_PER_NOTE=3

# Set to 0 for browsing/inspection without automatic generation or maintenance.
NOODLE_BACKGROUND_WORKERS=1

# New jobs follow source sections; frozen jobs retain their original route.
NOODLE_NEXT_GENERATION_LAYOUT=source-sections-v1

# New source-section jobs: stable entity planning; frozen jobs retain their profile.
NOODLE_NEXT_CONCEPT_LAYOUT=entity-v2
# Pro: all material topic planning/confirmation, Chinese labels/Concept outlines,
# and Concept ownership decisions. Writing, content review/repair and RAG: Flash.
# disabled / paper-plan-only retain earlier comparison modes.
NOODLE_NEXT_PRO_USAGE=planning-pro
